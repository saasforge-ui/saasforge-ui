# Base path for GitHub Pages project sites, e.g. /saasforge-ui/
# Leave unset for local dev and for a root domain deployment.
VITE_BASE_PATH=/

# Canonical site URL used for SEO, Open Graph and canonical links.
VITE_SITE_URL=https://saasforge-ui.github.io/saasforge-ui

# GitHub repository URL shown in "View on GitHub" CTAs.
VITE_GITHUB_URL=https://github.com/saasforge-ui/saasforge-ui

# Ko-fi product page URLs used by the PurchaseButton component's "Get Pro" /
# "Get Ultimate" CTAs. Safe to leave as placeholders — the buttons still work,
# they just won't point anywhere real until these are set.
VITE_KOFI_PRODUCT_URL=https://ko-fi.com/s/your-product-id
VITE_KOFI_ULTIMATE_URL=https://ko-fi.com/s/your-ultimate-id
