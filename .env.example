# Base path for GitHub Pages project sites, e.g. /saasforge-ui/
# Leave unset for local dev and for a root domain deployment.
VITE_BASE_PATH=/

# Canonical site URL used for SEO, Open Graph and canonical links.
VITE_SITE_URL=https://saasforge-ui.github.io/saasforge-ui

# GitHub repository URL shown in "View on GitHub" CTAs.
VITE_GITHUB_URL=https://github.com/saasforge-ui/saasforge-ui

# Ko-fi product URLs used by the PurchaseButton component (every "Get Pro" /
# "Get SaaSForge UI" / "Get Ultimate" CTA in the app reads these two values).
#
# Until you've set up Ko-fi, leave these as placeholders — the buttons will
# still work, they just won't point anywhere real yet. To wire up real sales:
#   1. Create a Ko-fi account at https://ko-fi.com (or use an existing one).
#   2. Go to "Shop" -> "Add new item" -> "Digital Download" and create two
#      products: "SaaSForge UI Pro" ($19) and "SaaSForge UI Ultimate" ($49).
#   3. Copy each product's public page URL and paste it below.
#   4. Restart `npm run dev` (or redeploy) so Vite picks up the new values.
VITE_KOFI_PRODUCT_URL=https://ko-fi.com/s/your-product-id
VITE_KOFI_ULTIMATE_URL=https://ko-fi.com/s/your-ultimate-id
